# Check-in QR Code (Ed25519)
# Gere com: node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('PRIV:',privateKey.replace(/\n/g,'\n'));console.log('PUB:',publicKey.replace(/\n/g,'\n'));"
CHECKIN_PRIVATE_KEY_PEM=
CHECKIN_PUBLIC_KEY_PEM=
NEXT_PUBLIC_APP_URL=https://app.koinos.com.br
# Geolocalização opcional: coordenadas do local do evento e raio máximo em metros
CHECKIN_MAX_RADIUS_METERS=500
